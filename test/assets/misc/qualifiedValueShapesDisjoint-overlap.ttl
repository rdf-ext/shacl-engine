@prefix ex: <http://example.org/>.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix sht: <http://www.w3.org/ns/shacl-test#>.

<> a mf:Manifest;
  mf:entries (<qualifiedValueShapesDisjoint-overlap>).

<qualifiedValueShapesDisjoint-overlap> a sht:Validate;
  rdfs:label "Test of sh:qualifiedValueShapesDisjoint with a value conforming to one of multiple sibling shapes";
  mf:action [
      sht:dataGraph <>;
      sht:shapesGraph <>
    ];
  mf:result [ a sh:ValidationReport;
      sh:conforms true
    ].

ex:MyShape a sh:NodeShape;
  sh:property [
      sh:path ex:part;
      sh:qualifiedMaxCount 1;
      sh:qualifiedValueShape [
          sh:class ex:Wheel
        ];
      sh:qualifiedValueShapesDisjoint true
    ], [
      sh:path ex:part;
      sh:qualifiedValueShape [
          sh:class ex:SpareWheel
        ]
    ], [
      sh:path ex:part;
      sh:qualifiedValueShape [
          sh:class ex:Engine
        ]
    ];
  sh:targetNode ex:ValidInstance1.

ex:ValidInstance1
  ex:part ex:Wheel1, ex:Wheel2.

ex:Wheel1 a ex:Wheel.

ex:Wheel2 a ex:SpareWheel, ex:Wheel.
