@prefix ex: <http://example.org/>.
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix sht: <http://www.w3.org/ns/shacl-test#>.

<> a mf:Manifest;
  mf:entries (<not-multi>).

<not-multi> a sht:Validate;
  rdfs:label "Test of sh:not with multiple values";
  mf:action [
      sht:dataGraph <>;
      sht:shapesGraph <>
    ];
  mf:result [ a sh:ValidationReport;
      sh:conforms false;
      sh:result [ a sh:ValidationResult;
          sh:focusNode ex:InvalidPoint1;
          sh:resultSeverity sh:Violation;
          sh:sourceConstraintComponent sh:NotConstraintComponent;
          sh:sourceShape ex:Point;
          sh:value ex:InvalidPoint1
        ]
    ].

ex:HasHeight
  sh:property [
      sh:minCount 1;
      sh:path ex:height
    ].

ex:HasWidth
  sh:property [
      sh:minCount 1;
      sh:path ex:width
    ].

ex:InvalidPoint1 a ex:Point;
  ex:height 3.

ex:Point a rdfs:Class, sh:NodeShape;
  rdfs:subClassOf rdfs:Resource;
  sh:not ex:HasWidth, ex:HasHeight.

ex:ValidPoint1 a ex:Point.
